generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String              @id @default(cuid())
  email              String              @unique
  passwordHash       String
  username           String?             @unique
  displayName        String              @default("")
  bio                String              @default("")
  avatar             String              @default("")
  favoriteGame       String              @default("")
  profileCompleted   Boolean             @default(false)
  role               String              @default("user")
  meta               String              @default("{}")
  createdAt          DateTime            @default(now())
  lastLogin          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  following          Follow[]            @relation("Following")
  followers          Follow[]            @relation("Followers")
  gameData           GameData[]
  gameSessions       GameSession[]
  memoryGameSessions MemoryGameSession[]
  scores             Score[]
  stats              UserStats?
  wordGameSessions   WordGameSession[]

  @@index([email])
  @@index([username])
  @@index([createdAt])
}

model UserStats {
  id             String   @id @default(cuid())
  userId         String   @unique
  followerCount  Int      @default(0)
  followingCount Int      @default(0)
  totalScore     Int      @default(0)
  gamesPlayed    Int      @default(0)
  updatedAt      DateTime @updatedAt
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Score {
  id         String   @id @default(cuid())
  game       String
  userId     String?
  playerName String   @default("guest")
  score      Int
  meta       String   @default("{}")
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([game])
  @@index([userId])
  @@index([game, score(sort: Desc)])
  @@index([playerName])
  @@index([createdAt])
}

model Follow {
  id          String   @id @default(cuid())
  followerId  String
  followingId String
  createdAt   DateTime @default(now())
  follower    User     @relation("Following", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Followers", fields: [followingId], references: [id], onDelete: Cascade)

  @@unique([followerId, followingId])
  @@index([followerId])
  @@index([followingId])
}

model Word {
  id            String    @id @default(cuid())
  word          String    @unique
  category      String    @default("General")
  difficulty    String    @default("beginner")
  language      String    @default("english")
  description   String
  definition    String?
  pronunciation String?
  etymology     String?
  examples      String    @default("[]")
  hints         String    @default("[]")
  frequency     Int       @default(50)
  status        String    @default("active")
  usageCount    Int       @default(0)
  lastUsed      DateTime?
  verifiedAt    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([category])
  @@index([difficulty])
  @@index([language])
  @@index([status])
}

model GameSession {
  id          String    @id @default(cuid())
  sessionId   String    @unique
  game        String
  userId      String?
  difficulty  String?
  gameMode    String?
  category    String?
  state       String    @default("{}")
  meta        String    @default("{}")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  duration    Int?
  completed   Boolean   @default(false)
  score       Int       @default(0)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id])

  @@index([game])
  @@index([userId])
  @@index([sessionId])
  @@index([completed])
  @@index([startedAt])
}

model WordGameSession {
  id               String    @id @default(cuid())
  sessionId        String    @unique
  userId           String?
  gameType         String
  difficulty       String    @default("medium")
  category         String?
  words            String    @default("[]")
  currentWordIndex Int       @default(0)
  score            Int       @default(0)
  moves            Int       @default(0)
  hintsUsed        Int       @default(0)
  correctGuesses   Int       @default(0)
  state            String    @default("{}")
  meta             String    @default("{}")
  startedAt        DateTime  @default(now())
  completedAt      DateTime?
  completed        Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  user             User?     @relation(fields: [userId], references: [id])

  @@index([gameType])
  @@index([userId])
  @@index([sessionId])
  @@index([completed])
}

model MemoryGameSession {
  id          String    @id @default(cuid())
  sessionId   String    @unique
  userId      String?
  difficulty  String    @default("easy")
  theme       String    @default("fruits")
  cards       String
  flips       String    @default("[]")
  matches     Int       @default(0)
  totalPairs  Int
  moves       Int       @default(0)
  score       Int       @default(0)
  state       String    @default("{}")
  meta        String    @default("{}")
  startedAt   DateTime  @default(now())
  completedAt DateTime?
  completed   Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  user        User?     @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([sessionId])
  @@index([completed])
}

model GameData {
  id        String    @id @default(cuid())
  game      String
  key       String
  value     String
  userId    String?
  expiresAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  user      User?     @relation(fields: [userId], references: [id])

  @@unique([game, key, userId])
  @@index([game])
  @@index([userId])
  @@index([expiresAt])
}
